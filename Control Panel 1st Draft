class EditDatabaseWindow(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent, bg=PANEL_BG)
        self.title("Edit Database")
        self.geometry("460x340")
        self.grab_set()

        tk.Label(self, text="Edit Student Database", bg=PANEL_BG, fg=TEXT, font=FONT_H).pack(pady=20)

        btn_frame = tk.Frame(self, bg=PANEL_BG)
        btn_frame.pack(pady=10)
        styled_btn(btn_frame, "➕  Add Student",    self._add,    color=SUCCESS, width=18, pady=14).pack(pady=8)
        styled_btn(btn_frame, "➖  Remove Student", self._remove, color=DANGER,  width=18, pady=14).pack(pady=8)
        styled_btn(btn_frame, "🗑  Remove Batch",   self._remove_batch, color=WARNING, width=18, pady=14).pack(pady=8)

    def _add(self):
        AddStudentWindow(self)

    def _remove(self):
        win = tk.Toplevel(self, bg=PANEL_BG)
        win.title("Remove Student")
        win.geometry("320x200")
        win.grab_set()

        tk.Label(win, text="Name", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=20, pady=(14,0))
        nf, nv, _ = entry_field(win, width=26); nf.pack()
        tk.Label(win, text="Roll Number", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=20, pady=(8,0))
        rf, rv, _ = entry_field(win, width=26); rf.pack()

        def submit():
            roll = rv.get().strip()
            if not roll:
                messagebox.showwarning("Input", "Roll number required", parent=win); return
            if messagebox.askyesno("Confirm", f"Remove student {nv.get()} ({roll})?", parent=win):
                remove_student(roll_no=roll)
                messagebox.showinfo("Done", "Student removed.", parent=win)
                win.destroy()

        styled_btn(win, "Remove", submit, color=DANGER, width=12).pack(pady=12)

    def _remove_batch(self):
        win = tk.Toplevel(self, bg=PANEL_BG)
        win.title("Remove Batch")
        win.geometry("320x180")
        win.grab_set()

        tk.Label(win, text="Program", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=20, pady=(14,0))
        pv = tk.StringVar()
        ttk.Combobox(win, textvariable=pv, values=["BSc","MSc","PhD"],
                     state="readonly", width=22).pack(padx=20)
        tk.Label(win, text="Batch (e.g. 2022-2025)", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=20, pady=(8,0))
        bf, bv, _ = entry_field(win, width=26); bf.pack()

        def submit():
            p, b = pv.get().strip(), bv.get().strip()
            if not p or not b:
                messagebox.showwarning("Input", "Both fields required", parent=win); return
            if messagebox.askyesno("Confirm", f"Remove entire batch {b} of {p}?", parent=win):
                remove_batch(p, b)
                messagebox.showinfo("Done", f"Batch {b} removed.", parent=win)
                win.destroy()

        styled_btn(win, "Remove Batch", submit, color=DANGER, width=14).pack(pady=12)


class AddStudentWindow(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent, bg=PANEL_BG)
        self.title("Add Student")
        self.geometry("520x540")
        self.grab_set()

        tk.Label(self, text="Add New Student", bg=PANEL_BG, fg=TEXT, font=FONT_H).pack(pady=14)

        form = tk.Frame(self, bg=PANEL_BG)
        form.pack(fill="both", expand=True, padx=30)

        fields = [
            ("Name",         "Full name",           "name",    False),
            ("Roll Number",  "e.g. 4530",           "roll",    False),
            ("Program",      None,                  "prog",    True,  ["BSc","MSc","PhD"]),
            ("Batch",        "e.g. 2024-2027",      "batch",   False),
            ("Year",         None,                  "year",    True,  ["1st Yr","2nd Yr","3rd Yr"]),
            ("Contact Info", "Phone / Email",       "contact", False),
            ("Role",         None,                  "role",    True,  ["Student","Faculty","Staff"]),
        ]
        self._vars = {}
        for row in fields:
            label, ph, key, is_combo = row[0], row[1], row[2], row[3]
            opts = row[4] if len(row) > 4 else None
            tk.Label(form, text=label, bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", pady=(6,0))
            v = tk.StringVar()
            if is_combo:
                cb = ttk.Combobox(form, textvariable=v, values=opts, state="readonly", width=36)
                cb.pack(fill="x")
                if opts: cb.set(opts[0])
            else:
                f, v2, _ = entry_field(form, placeholder=ph or "", width=38)
                f.pack(fill="x")
                v = v2
            self._vars[key] = v

        self._err = tk.Label(self, text="", bg=PANEL_BG, fg=DANGER, font=FONT_S)
        self._err.pack()

        styled_btn(self, "Add Student", self._submit, color=SUCCESS, width=16).pack(pady=12)

    def _submit(self):
        v = {k: var.get().strip() for k, var in self._vars.items()}
        required = ["name","roll","prog","batch","year"]
        for k in required:
            val = v[k]
            if not val or val.startswith("🔍"):
                self._err.config(text=f"Field '{k}' is required"); return
        try:
            add_student(v["roll"], v["name"], v["prog"], v["batch"],
                        v["year"], v["contact"], v["role"] or "Student")
            messagebox.showinfo("Success", f"Student {v['name']} added.", parent=self)
            self.destroy()
        except Exception as e:
            self._err.config(text=f"Error: {e}")


