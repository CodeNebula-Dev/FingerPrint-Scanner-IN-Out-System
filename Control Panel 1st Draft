# ─── Reusable Widgets ──────────────────────────────────────────────────────────

def styled_btn(parent, text, cmd, color=ACCENT, width=12, pady=4):
    b = tk.Button(parent, text=text, command=cmd,
                  bg=color, fg=TEXT, font=FONT_M,
                  relief="flat", cursor="hand2",
                  padx=10, pady=pady, width=width,
                  activebackground=BORDER, activeforeground=TEXT,
                  bd=0)
    return b


def entry_field(parent, placeholder="", width=20, show=""):
    frame = tk.Frame(parent, bg=PANEL_BG, bd=0)
    var = tk.StringVar()
    e = tk.Entry(frame, textvariable=var, width=width, show=show,
                 bg=BORDER, fg=TEXT, insertbackground=TEXT,
                 relief="flat", font=FONT_M,
                 bd=0)
    e.pack(ipady=5, padx=2, pady=2)
    if placeholder:
        e.insert(0, placeholder)
        e.config(fg=SUBTEXT)
        def on_focus_in(evt, e=e, ph=placeholder):
            if e.get() == ph: e.delete(0, "end"); e.config(fg=TEXT)
        def on_focus_out(evt, e=e, ph=placeholder):
            if not e.get(): e.insert(0, ph); e.config(fg=SUBTEXT)
        e.bind("<FocusIn>",  on_focus_in)
        e.bind("<FocusOut>", on_focus_out)
    return frame, var, e


def section_label(parent, text):
    tk.Label(parent, text=text, bg=PANEL_BG, fg=SUBTEXT,
             font=FONT_S).pack(anchor="w", padx=4)


def make_tree(parent, columns, show_scroll=True):
    style = ttk.Style()
    style.theme_use("clam")
    style.configure("Dark.Treeview",
        background=ROW_EVEN, foreground=TEXT, fieldbackground=ROW_EVEN,
        borderwidth=0, font=FONT_M, rowheight=28)
    style.configure("Dark.Treeview.Heading",
        background=ACCENT2, foreground=TEXT, font=("Segoe UI", 10, "bold"),
        relief="flat")
    style.map("Dark.Treeview",
        background=[("selected", SEL_BG)],
        foreground=[("selected", TEXT)])

    frame = tk.Frame(parent, bg=BG)
    tree = ttk.Treeview(frame, columns=columns, show="headings",
                        style="Dark.Treeview", selectmode="browse")
    for col in columns:
        w = 140 if col not in ("Name",) else 160
        if col in ("Entry Time","Exit Time"): w = 110
        if col in ("Roll No.",): w = 80
        if col in ("Year","Role"): w = 80
        tree.heading(col, text=col)
        tree.column(col, width=w, minwidth=60, anchor="center")
    tree.tag_configure("odd",  background=ROW_ODD)
    tree.tag_configure("even", background=ROW_EVEN)

    vsb = ttk.Scrollbar(frame, orient="vertical", command=tree.yview)
    tree.configure(yscrollcommand=vsb.set)
    tree.pack(side="left", fill="both", expand=True)
    if show_scroll:
        vsb.pack(side="right", fill="y")
    frame.pack(fill="both", expand=True)
    return tree


def populate_tree(tree, rows, col_keys):
    tree.delete(*tree.get_children())
    for i, row in enumerate(rows):
        values = [row.get(k, "") or "" for k in col_keys]
        tag = "even" if i % 2 == 0 else "odd"
        tree.insert("", "end", values=values, tags=(tag,))


# ─── Main App Window ────────────────────────────────────────────────────────────

class FingerprintApp(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("Fingerprint Attendance Control Panel")
        self.configure(bg=BG)
        self.geometry("1200x750")
        self.minsize(1000, 650)
        self._build_ui()
        self.show_panel("Log")

    def _build_ui(self):
        # ── Top bar ──
        top = tk.Frame(self, bg=PANEL_BG, height=54)
        top.pack(fill="x")
        top.pack_propagate(False)

        tk.Label(top, text="🔒 Institute Attendance System",
                 bg=PANEL_BG, fg=TEXT, font=FONT_H).pack(side="left", padx=18, pady=12)

        tk.Label(top, text=f"📅 {date.today().strftime('%d %b %Y')}",
                 bg=PANEL_BG, fg=SUBTEXT, font=FONT_M).pack(side="right", padx=18, pady=12)

        # ── Nav tabs ──
        nav = tk.Frame(self, bg=BG, pady=0)
        nav.pack(fill="x")
        self._nav_buttons = {}
        panels = ["Log", "Out", "Systems Control", "Requests", "Home"]
        for p in panels:
            b = tk.Button(nav, text=p, bg=BG, fg=SUBTEXT,
                          font=("Segoe UI", 10, "bold"),
                          relief="flat", cursor="hand2",
                          padx=20, pady=10, bd=0,
                          activebackground=ACCENT, activeforeground=TEXT,
                          command=lambda x=p: self.show_panel(x))
            b.pack(side="left")
            self._nav_buttons[p] = b

        sep = tk.Frame(self, bg=BORDER, height=2)
        sep.pack(fill="x")

        # ── Content area ──
        self._content = tk.Frame(self, bg=BG)
        self._content.pack(fill="both", expand=True)

        # Build each panel (hidden initially)
        self._panels = {
            "Log":             LogPanel(self._content, self),
            "Out":             OutPanel(self._content, self),
            "Systems Control": SystemsControlPanel(self._content, self),
            "Requests":        RequestsPanel(self._content, self),
            "Home":            HomePanel(self._content, self),
        }
        for panel in self._panels.values():
            panel.place(relwidth=1, relheight=1)

    def show_panel(self, name):
        for k, btn in self._nav_buttons.items():
            if k == name:
                btn.config(bg=ACCENT, fg=TEXT)
            else:
                btn.config(bg=BG, fg=SUBTEXT)
        panel = self._panels.get(name)
        if panel:
            panel.lift()
            panel.refresh()


# ─── Log Panel ─────────────────────────────────────────────────────────────────

class LogPanel(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=BG)
        self.app = app
        self._filters = {}
        self._build()

    def _build(self):
        # ── Toolbar ──
        bar = tk.Frame(self, bg=PANEL_BG, pady=8)
        bar.pack(fill="x", padx=0)

        # Search
        sf, self._search_var, se = entry_field(bar, placeholder="🔍  Search name / roll no.", width=28)
        sf.pack(side="left", padx=(12,6))
        self._search_var.trace_add("write", lambda *_: self._load())

        # Period picker
        styled_btn(bar, "📅 Period", self._pick_period, color=ACCENT2, width=10).pack(side="left", padx=4)
        self._period_label = tk.Label(bar, text="All dates", bg=PANEL_BG, fg=SUBTEXT, font=FONT_S)
        self._period_label.pack(side="left", padx=4)

        # Today shortcut
        styled_btn(bar, "Today", self._set_today, color=ACCENT, width=7).pack(side="left", padx=4)

        # Export
        styled_btn(bar, "⬇ Export", self._export, color=SUCCESS, width=9).pack(side="right", padx=(4,12))

        # Filter
        styled_btn(bar, "⚙ Filter", self._open_filter, color=ACCENT2, width=8).pack(side="right", padx=4)

        sep2 = tk.Frame(self, bg=BORDER, height=2)
        sep2.pack(fill="x")

        # ── Table ──
        cols = ["Name","Roll No.","Year","Reason","Program","Role","Entry Time","Exit Time","Date"]
        self._keys = ["name","roll_no","year","reason","program","role","entry_time","exit_time","log_date"]
        self._tree = make_tree(self, cols)

        # Status bar
        self._status = tk.Label(self, text="", bg=BG, fg=SUBTEXT, font=FONT_S)
        self._status.pack(anchor="w", padx=12, pady=4)

        self._start_date = None
        self._end_date   = None

    def _load(self):
        q = self._search_var.get()
        if q in ("", "🔍  Search name / roll no."):
            q = None
        rows = get_logs(
            start_date=self._start_date,
            end_date=self._end_date,
            year=self._filters.get("year"),
            program=self._filters.get("program"),
            role=self._filters.get("role"),
            reason=self._filters.get("reason"),
            search=q
        )
        populate_tree(self._tree, rows, self._keys)
        self._status.config(text=f"  {len(rows)} record(s)")

    def refresh(self):
        self._load()

    def _set_today(self):
        today = date.today().isoformat()
        self._start_date = today
        self._end_date   = today
        self._period_label.config(text=f"Today  ({today})")
        self._load()

    def _pick_period(self):
        win = tk.Toplevel(self, bg=PANEL_BG)
        win.title("Select Period")
        win.geometry("340x200")
        win.resizable(False, False)
        win.grab_set()

        tk.Label(win, text="Start Date (YYYY-MM-DD)", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(pady=(16,2))
        sf, sv, se = entry_field(win, width=20)
        sf.pack()
        sv.set(self._start_date or "")

        tk.Label(win, text="End Date (YYYY-MM-DD)", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(pady=(8,2))
        ef, ev, ee = entry_field(win, width=20)
        ef.pack()
        ev.set(self._end_date or "")

        def apply():
            self._start_date = sv.get().strip() or None
            self._end_date   = ev.get().strip() or None
            lbl = f"{self._start_date or '∞'} → {self._end_date or '∞'}"
            self._period_label.config(text=lbl)
            win.destroy()
            self._load()

        styled_btn(win, "Apply", apply, width=10).pack(pady=12)

    def _open_filter(self):
        win = tk.Toplevel(self, bg=PANEL_BG)
        win.title("Filter")
        win.geometry("260x280")
        win.resizable(False, False)
        win.grab_set()

        fields = [
            ("Year",    ["", "1st Yr","2nd Yr","3rd Yr"]),
            ("Program", ["", "BSc","MSc","PhD"]),
            ("Role",    ["", "Student","Faculty","Staff"]),
            ("Reason",  ["", "Medical","Market","Exam","Home"]),
        ]
        vars_ = {}
        for label, opts in fields:
            tk.Label(win, text=label, bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=16, pady=(8,0))
            v = tk.StringVar(value=self._filters.get(label.lower(), ""))
            cb = ttk.Combobox(win, textvariable=v, values=opts, state="readonly", width=22)
            cb.pack(padx=16)
            vars_[label.lower()] = v

        def apply():
            self._filters = {k: v.get() or None for k, v in vars_.items()}
            win.destroy()
            self._load()

        styled_btn(win, "Apply", apply, width=10).pack(pady=14)

    def _export(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".csv", filetypes=[("CSV","*.csv")],
            initialfile=f"attendance_{date.today()}.csv")
        if path:
            export_logs_to_csv(path,
                start_date=self._start_date, end_date=self._end_date)
            messagebox.showinfo("Exported", f"Saved to:\n{path}")


