class RequestsPanel(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=BG)
        self.app = app
        self._rows = []
        self._build()

    def _build(self):
        bar = tk.Frame(self, bg=PANEL_BG, pady=8)
        bar.pack(fill="x")
        tk.Label(bar, text="Pending Home Requests", bg=PANEL_BG, fg=TEXT, font=FONT_H).pack(side="left", padx=14)
        styled_btn(bar, "↻ Refresh", self.refresh, width=9).pack(side="right", padx=12)
        tk.Frame(self, bg=BORDER, height=2).pack(fill="x")

        self._list_frame = tk.Frame(self, bg=BG)
        self._list_frame.pack(fill="both", expand=True, padx=16, pady=10)

    def refresh(self):
        for w in self._list_frame.winfo_children():
            w.destroy()
        self._rows = get_pending_requests()
        if not self._rows:
            tk.Label(self._list_frame, text="✅  No pending requests",
                     bg=BG, fg=SUBTEXT, font=FONT_M).pack(pady=30)
            return
        for req in self._rows:
            self._make_request_card(req)

    def _make_request_card(self, req):
        card = tk.Frame(self._list_frame, bg=PANEL_BG, pady=10, padx=12)
        card.pack(fill="x", pady=5)

        info = (f"  {req['name']}  (Roll: {req['roll_no']})  —  "
                f"{req['program']}  |  Departure: {req.get('departure_date','')}  "
                f"  Return: {req.get('expected_return','')}")
        tk.Label(card, text=info, bg=PANEL_BG, fg=TEXT, font=FONT_M,
                 anchor="w").pack(side="left", fill="x", expand=True)

        rid = req["id"]
        styled_btn(card, "✓ Approve", lambda r=rid: self._decide(r, True),
                   color=SUCCESS, width=10).pack(side="right", padx=(4,0))
        styled_btn(card, "✕ Reject",  lambda r=rid: self._decide(r, False),
                   color=DANGER, width=10).pack(side="right", padx=(4,4))

    def _decide(self, record_id, approve):
        approve_request(record_id, approve)
        self.refresh()


