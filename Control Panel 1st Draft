class ViewDatabaseWindow(tk.Toplevel):
    def __init__(self, parent):
        super().__init__(parent, bg=PANEL_BG)
        self.title("View Database")
        self.geometry("1000x580")
        self.grab_set()

        bar = tk.Frame(self, bg=PANEL_BG, pady=8)
        bar.pack(fill="x")
        self._view_var = tk.StringVar(value="Students")
        for v in ["Students", "Log Files"]:
            tk.Radiobutton(bar, text=v, variable=self._view_var, value=v,
                           bg=PANEL_BG, fg=TEXT, selectcolor=ACCENT,
                           activebackground=PANEL_BG, font=FONT_M,
                           command=self._switch).pack(side="left", padx=14)

        # Students view
        self._stud_frame = tk.Frame(self, bg=BG)
        sbar = tk.Frame(self._stud_frame, bg=PANEL_BG, pady=6)
        sbar.pack(fill="x")
        sf, self._s_search, se = entry_field(sbar, placeholder="🔍 Search", width=24)
        sf.pack(side="left", padx=10)
        self._s_search.trace_add("write", lambda *_: self._load_students())
        self._prog_var = tk.StringVar(value="All")
        cb = ttk.Combobox(sbar, textvariable=self._prog_var, values=["All","BSc","MSc","PhD"],
                          state="readonly", width=10)
        cb.pack(side="left", padx=6)
        cb.bind("<<ComboboxSelected>>", lambda _: self._load_students())
        styled_btn(sbar, "Export CSV", self._export_students, color=SUCCESS, width=10).pack(side="right", padx=10)

        scols = ["Name","Roll No.","Program","Batch","Year","Contact Info","Role"]
        self._s_keys = ["name","roll_no","program","batch","year","contact_info","role"]
        self._s_tree = make_tree(self._stud_frame, scols)

        # Log files view
        self._log_frame = tk.Frame(self, bg=BG)
        lbar = tk.Frame(self._log_frame, bg=PANEL_BG, pady=6)
        lbar.pack(fill="x")
        styled_btn(lbar, "Export",            self._export_logs, color=SUCCESS, width=10).pack(side="left", padx=10)
        styled_btn(lbar, "Export & Delete",   self._export_delete, color=DANGER, width=14).pack(side="left", padx=4)
        lcols = ["Name","Roll No.","Program","Year","Reason","Entry Time","Exit Time","Date"]
        self._l_keys = ["name","roll_no","program","year","reason","entry_time","exit_time","log_date"]
        self._l_tree = make_tree(self._log_frame, lcols)

        self._switch()

    def _switch(self):
        v = self._view_var.get()
        self._stud_frame.pack_forget()
        self._log_frame.pack_forget()
        if v == "Students":
            self._stud_frame.pack(fill="both", expand=True)
            self._load_students()
        else:
            self._log_frame.pack(fill="both", expand=True)
            self._load_logs()

    def _load_students(self):
        q = self._s_search.get()
        if q in ("", "🔍 Search"): q = None
        p = self._prog_var.get()
        if q:
            rows = search_students(q)
        else:
            rows = get_all_students(program=None if p == "All" else p)
        populate_tree(self._s_tree, rows, self._s_keys)

    def _load_logs(self):
        rows = get_logs()
        populate_tree(self._l_tree, rows, self._l_keys)

    def _export_students(self):
        import csv
        path = filedialog.asksaveasfilename(
            defaultextension=".csv", filetypes=[("CSV","*.csv")],
            initialfile="students.csv", parent=self)
        if path:
            rows = get_all_students()
            with open(path, "w", newline="", encoding="utf-8") as f:
                if rows:
                    writer = csv.DictWriter(f, fieldnames=[k for k in rows[0] if k!="fingerprint"])
                    writer.writeheader()
                    for r in rows:
                        r.pop("fingerprint", None)
                        writer.writerow(r)
            messagebox.showinfo("Exported", f"Saved to:\n{path}", parent=self)

    def _export_logs(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".csv", filetypes=[("CSV","*.csv")],
            initialfile=f"logs_{date.today()}.csv", parent=self)
        if path:
            export_logs_to_csv(path)
            messagebox.showinfo("Exported", f"Saved to:\n{path}", parent=self)

    def _export_delete(self):
        if not messagebox.askyesno("Confirm",
            "Export all logs to CSV and DELETE from database?", parent=self):
            return
        path = filedialog.asksaveasfilename(
            defaultextension=".csv", filetypes=[("CSV","*.csv")],
            initialfile=f"logs_archive_{date.today()}.csv", parent=self)
        if path:
            export_logs_to_csv(path, delete_after=True)
            messagebox.showinfo("Done", f"Exported and deleted.\nArchive at:\n{path}", parent=self)
            self._load_logs()


