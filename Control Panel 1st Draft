class SystemsControlPanel(tk.Frame):
    def __init__(self, parent, app):
        super().__init__(parent, bg=BG)
        self.app = app
        self._authenticated = False
        self._build_lock_screen()

    def _build_lock_screen(self):
        self._lock_frame = tk.Frame(self, bg=BG)
        self._lock_frame.place(relwidth=1, relheight=1)

        inner = tk.Frame(self._lock_frame, bg=PANEL_BG, padx=40, pady=40)
        inner.place(relx=0.5, rely=0.45, anchor="center")

        tk.Label(inner, text="🔐  Systems Control", bg=PANEL_BG, fg=TEXT, font=FONT_H).pack(pady=(0,4))
        tk.Label(inner, text="Password-protected administrative panel",
                 bg=PANEL_BG, fg=SUBTEXT, font=FONT_S).pack(pady=(0,20))

        tk.Label(inner, text="Enter Password:", bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w")
        pf, self._pwd_var, pe = entry_field(inner, width=28, show="●")
        pf.pack(pady=6)
        pe.bind("<Return>", lambda _: self._authenticate())

        self._err_lbl = tk.Label(inner, text="", bg=PANEL_BG, fg=DANGER, font=FONT_S)
        self._err_lbl.pack()

        styled_btn(inner, "Unlock", self._authenticate, color=ACCENT, width=12).pack(pady=10)
        tk.Label(inner, text="Default password: admin123",
                 bg=PANEL_BG, fg=SUBTEXT, font=FONT_S).pack(pady=(8,0))

    def _authenticate(self):
        pwd = self._pwd_var.get()
        if verify_admin(pwd):
            self._authenticated = True
            self._lock_frame.place_forget()
            self._build_admin_panel()
        else:
            self._err_lbl.config(text="⚠  Incorrect password")

    def _build_admin_panel(self):
        self._admin_frame = tk.Frame(self, bg=BG)
        self._admin_frame.place(relwidth=1, relheight=1)

        # Nav sub-tabs
        subbar = tk.Frame(self._admin_frame, bg=PANEL_BG, pady=8)
        subbar.pack(fill="x")
        tk.Label(subbar, text="⚙  Systems Control  —  Authenticated",
                 bg=PANEL_BG, fg=SUCCESS, font=FONT_H).pack(side="left", padx=14)
        styled_btn(subbar, "🔒 Lock", self._lock, color=DANGER, width=8).pack(side="right", padx=12)

        tk.Frame(self._admin_frame, bg=BORDER, height=2).pack(fill="x")

        # Action buttons
        center = tk.Frame(self._admin_frame, bg=BG)
        center.pack(fill="both", expand=True)

        btn_row = tk.Frame(center, bg=BG)
        btn_row.place(relx=0.5, rely=0.35, anchor="center")

        styled_btn(btn_row, "✏  Edit Database", self._show_edit_db,
                   color=ACCENT, width=20, pady=16).pack(side="left", padx=16)
        styled_btn(btn_row, "👁  View Database", self._show_view_db,
                   color=ACCENT2, width=20, pady=16).pack(side="left", padx=16)
        styled_btn(btn_row, "🔑  Change Password", self._change_password,
                   color=WARNING, width=20, pady=16).pack(side="left", padx=16)

        self._db_frame = tk.Frame(center, bg=BG)
        self._db_frame.pack(fill="both", expand=True, padx=10, pady=10)

    def _lock(self):
        self._authenticated = False
        if hasattr(self, "_admin_frame"):
            self._admin_frame.place_forget()
        self._pwd_var.set("")
        self._err_lbl.config(text="")
        self._lock_frame.place(relwidth=1, relheight=1)

    def refresh(self):
        pass  # Lock screen stays until password

    def _show_edit_db(self):
        EditDatabaseWindow(self)

    def _show_view_db(self):
        ViewDatabaseWindow(self)

    def _change_password(self):
        win = tk.Toplevel(self, bg=PANEL_BG)
        win.title("Change Password")
        win.geometry("320x240")
        win.grab_set()

        for lbl, show, attr in [
            ("Current Password", "●", "old"),
            ("New Password",     "●", "new"),
            ("Confirm New",      "●", "cnf"),
        ]:
            tk.Label(win, text=lbl, bg=PANEL_BG, fg=TEXT, font=FONT_M).pack(anchor="w", padx=20, pady=(10,0))
            f, v, _ = entry_field(win, width=26, show=show)
            f.pack()
            setattr(win, f"_{attr}_var", v)

        err = tk.Label(win, text="", bg=PANEL_BG, fg=DANGER, font=FONT_S)
        err.pack()

        def submit():
            old = win._old_var.get()
            new = win._new_var.get()
            cnf = win._cnf_var.get()
            if new != cnf:
                err.config(text="New passwords don't match"); return
            ok, msg = change_password(old, new)
            if ok:
                messagebox.showinfo("Success", msg, parent=win)
                win.destroy()
            else:
                err.config(text=msg)

        styled_btn(win, "Change", submit, width=12).pack(pady=10)


